meta {
  name: 01 Intento tras la ventana
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usuario": "{{usuario}}",
    "password": "contrasena-incorrecta"
  }
}

tests {
  test("Ya no esta bloqueado: 401 (no 429) y el contador empezo de nuevo", function() {
    expect(res.status).to.equal(401);
    expect(res.body.intentosRestantes).to.equal(4);
  });
}
