post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usuario": "{{usuario}}",
    "password": "contrasena-incorrecta"
  }
}

tests {
  test("401 y quedan 4 intentos", function() {
    expect(res.status).to.equal(401);
    expect(res.body.intentosRestantes).to.equal(4);
  });
}
