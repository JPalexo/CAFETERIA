meta {
  name: 06 Intento 6 bloqueado
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usuario": "{{usuario}}",
    "password": "contrasena-incorrecta"
  }
}

tests {
  test("429 Too Many Requests", function() {
    expect(res.status).to.equal(429);
  });
  test("Encabezado Retry-After", function() {
    expect(res.headers["retry-after"]).to.exist;
  });
  test("JSON descriptivo", function() {
    expect(res.body.error).to.be.a("string");
    expect(res.body.intentosPermitidos).to.equal(5);
    expect(res.body.retryAfterSeconds).to.be.a("number");
  });
}
