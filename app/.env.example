# Copia este archivo como .env y ajusta si es necesario.
# Es la misma cadena que usa tu conexion "MAIN" en Compass
# (en Compass: clic en "..." de MAIN > Copy connection string).
MONGODB_URI=mongodb://localhost:27017
DB_NAME=CAFETERIA
PORT=3000

# Rate limit del login: intentos fallidos permitidos por IP y ventana en segundos
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEG=60

# Sesiones: duracion en horas. Con SESION_MODO_PRUEBA=true la alerta sale a los 10 s
# y "Extender" no cambia el tiempo real de la sesion.
SESION_HORAS=8
SESION_MODO_PRUEBA=false

# Primer administrador (npm run crear-admin). Pon tu propia contrasena (minimo 8 caracteres).
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=cambia-esta-contrasena
